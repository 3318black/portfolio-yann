# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local est ignoré par git : aucune clé ne doit être committée.

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_TO_EMAIL=ton.adresse@exemple.com

# Expéditeur affiché. Le domaine doit être vérifié dans Resend.
# En développement, "Portfolio <onboarding@resend.dev>" fonctionne sans domaine
# vérifié, mais n'envoie qu'à l'adresse du compte Resend.
CONTACT_FROM_EMAIL="Portfolio Yann <onboarding@resend.dev>"

# URL publique du site — sert aux métadonnées et aux cartes de partage.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
